{
  "name": "zcode-cli",
  "version": "0.16.9",
  "private": true,
  "description": "A cross-platform TypeScript Node.js CLI with a small TUI and optional SEA packaging.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:sea": "pnpm --filter @zcode/cli build:sea",
    "check": "pnpm registry:check && turbo run typecheck",
    "clean": "turbo run clean",
    "cli:build": "pnpm --filter @zcode/cli build",
    "cli:dev": "pnpm --filter @zcode/cli dev",
    "cli:upload-sea": "pnpm --filter @zcode/cli upload:sea",
    "dev": "pnpm --filter @zcode/cli dev",
    "format": "oxfmt --write package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "format:check": "oxfmt --check package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "lint": "turbo run lint",
    "lint:count": "node scripts/count-ts-lines.mjs",
    "lint:fix": "turbo run lint:fix",
    "prompt-trajectory:model-io": "pnpm --filter @zcode/prompt-trajectory model-io --",
    "registry:check": "node scripts/generate-bash-command-registry.mjs --check",
    "registry:generate": "node scripts/generate-bash-command-registry.mjs",
    "release": "node ../../node_modules/release-it/bin/release-it.js --config .release-it.json",
    "release:dry": "pnpm run release --release-version",
    "sea": "pnpm --filter @zcode/cli sea",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "proxy-agent": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@withfig/autocomplete": "2.692.3",
    "c8": "^11.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "turbo": "^2.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.33.2"
}
