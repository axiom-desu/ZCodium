{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/presentations-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "PPTX presentation production skills and a PowerPoint viewer panel, published as an official ZCode plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "zcode-office-build",
    "clean": "node ../../scripts/clean-dist.mjs",
    "smoke": "zcode-office-smoke",
    "test:e2e": "zcode-office-e2e"
  },
  "devDependencies": {
    "@zcode/office-runtime": "workspace:*"
  },
  "office": {
    "title": {
      "en": "Presentations",
      "zh-CN": "演示文稿"
    },
    "kinds": [
      "pptx"
    ]
  }
}
