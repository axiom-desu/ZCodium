        "execution": {
          "taskSupport": "forbidden"
        },
        "_meta": {
          "ui": {
            "visibility": ["app"]
          }
        }
      },
      {
        "name": "load_document",
        "description": "Load a document for rendering in the viewer: returns its info and a handle to read the bytes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": ["path"],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
