          }
        }
      },
      {
        "name": "check_document",
        "description": "Return a document's current revision so the viewer can tell when the file changed on disk.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": ["path"],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
