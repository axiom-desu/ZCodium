        "_meta": {
          "ui": {
            "visibility": ["app"]
          }
        }
      },
      {
        "name": "report_view",
        "description": "Record the user's current location and selection in the viewer.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "viewId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "at": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "selection": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 20000
                    }
                  },
                  "required": ["at", "text"]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["path"],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false
        },
        "execution": {
          "taskSupport": "forbidden"
        },
        "_meta": {
          "ui": {
            "visibility": ["app"]
          }
        }
      },
      {
        "name": "release_view",
        "description": "Release a viewer report when its page leaves.",
        "inputSchema": {
          "type": "object",
          "properties": {
